# Copy thành .dev.vars (đã có trong .gitignore) và điền giá trị. Production: `wrangler secret put <TÊN>`.
TOKEN_ENC_KEY=
FB_APP_ID=
FB_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Không bắt buộc: bật AI viết caption / bài hỏi fan (Claude API, console.anthropic.com). Để trống thì tắt.
ANTHROPIC_API_KEY=
# Chỉ dùng local: bỏ qua kiểm JWT Access khi hostname là localhost. Không bao giờ đặt trên production.
DEV_AUTH_BYPASS=
