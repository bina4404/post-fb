# Copy thành .dev.vars (đã có trong .gitignore) và điền giá trị. Production: `wrangler secret put <TÊN>`.
TOKEN_ENC_KEY=
FB_APP_ID=
FB_APP_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Chỉ dùng local: bỏ qua kiểm JWT Access khi hostname là localhost. Không bao giờ đặt trên production.
DEV_AUTH_BYPASS=
