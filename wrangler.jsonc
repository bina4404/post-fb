{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "post-fb",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	// Chỉ phục vụ qua tools.new2h.com (Cloudflare Access bảo vệ). Tắt *.workers.dev để không có hostname thứ hai.
	"workers_dev": false,
	"routes": [{ "pattern": "tools.new2h.com", "custom_domain": true }],
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "post-fb",
			"database_id": "f959d5f7-0eb1-41d6-9ba0-0389d93ecf56",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	// Không dùng dead letter queue: cron là nơi đẩy lại việc, consumer luôn ack (PLAN.md mục 5).
	"queues": {
		"producers": [
			{
				"binding": "PUBLISH_QUEUE",
				"queue": "post-fb-publish"
			}
		],
		"consumers": [
			{
				"queue": "post-fb-publish",
				"max_batch_size": 10
			}
		]
	},
	"vars": {
		"GRAPH_API_VERSION": "v27.0",
		"ACCESS_TEAM_DOMAIN": "bina4404.cloudflareaccess.com",
		"ACCESS_AUD": "58da1241a30d5493391328a7d8b800ae0fe13c896106da3f0ca2055825990c79"
	}
}